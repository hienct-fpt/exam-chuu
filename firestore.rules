rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Answer keys: never readable from the client. Cloud Functions use the Admin SDK (bypasses rules).
    match /answerKeys/{examId} {
      // 保護者 (admin claim) only: the 試験一覧 preview shows the answers. Students never read keys.
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public catalog (metadata only, no answers).
    match /exams/{examId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /topics/{topicId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /questionMeta/{examId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Parent <-> child links live on the profiles (students/{child}.parents, students/{parent}.children) and are
    // written only by the redeem_invite / unlink_child Cloud Functions. A parent sees and grades linked children only.
    function isParentOf(uid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/students/$(uid)).data.get('parents', []);
    }

    // Invite codes: a parent (admin claim) creates one, the child redeems it through redeem_invite.
    match /invites/{code} {
      allow read, delete: if signedIn() && resource.data.parentUid == request.auth.uid;
      allow create: if isAdmin()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['parentUid', 'parentName', 'createdAt', 'expiresAt'])
        && request.resource.data.expiresAt is timestamp;
    }

    // Student profile + attempts.
    match /students/{uid} {
      allow read: if isOwner(uid) || (signedIn() && request.auth.uid in resource.data.get('parents', []));
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(['role', 'parents', 'parentNames', 'children', 'loginId', 'plan']);
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'parents', 'parentNames', 'children', 'loginId', 'plan']);

      match /attempts/{attemptId} {
        allow read: if isOwner(uid) || isParentOf(uid);
        // Student may create and edit an attempt only while it is in progress, then submit it once.
        // Cross-exam practice sets have no examId; they carry the item ids instead.
        allow create: if isOwner(uid)
          && request.resource.data.status == 'in_progress'
          && (request.resource.data.examId is string
            || (request.resource.data.examId == null && request.resource.data.mode == 'practice'
              && request.resource.data.items is list && request.resource.data.items.size() > 0));
        allow update: if (isOwner(uid)
          && resource.data.status == 'in_progress'
          && request.resource.data.status in ['in_progress', 'submitted']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['result', 'score', 'gradedAt', 'examId', 'startedAt', 'manualGrades', 'itemIds', 'gradeFilter']))
          // Linked parent: ○/× on 記述・作図 only; the Cloud Function regrades.
          || (isParentOf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['manualGrades', 'updatedAt']));
        allow delete: if false;
      }

      match /topicStats/{topicId} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if false; // Cloud Function (Admin SDK) only
      }

      // 今週の目標: frozen once per week by the Cloud Function (functions/goals.py); 組分け scores sent by the parent.
      match /weeklyGoals/{weekStart} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if false;
      }
      match /kumiwakeScores/{round} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if false;
      }
    }
  }
}
