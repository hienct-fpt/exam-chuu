# firebase/firestore-send-email configuration (instance declared in firebase.json -> "extensions")
# Replace REPLACE_SENDER with the Gmail address that sends the reports, then `firebase deploy --only extensions`.
# SMTP_PASSWORD (Gmail app password) is a secret: the CLI prompts for it on deploy and stores it in Secret Manager;
# for emulators put SMTP_PASSWORD=... in extensions/firestore-send-email.secret.local (git-ignored).
# v0.2.x: DATABASE_REGION must equal the Firestore location shown in Console > Firestore Database
DATABASE=(default)
DATABASE_REGION=asia-northeast1
AUTH_TYPE=UsernamePassword
MAIL_COLLECTION=mail
# Real addresses go in extensions/firestore-send-email.env.<project-id> (git-ignored), which overrides this file on deploy.
DEFAULT_FROM=Exam Practice <REPLACE_SENDER@gmail.com>
DEFAULT_REPLY_TO=REPLACE_PARENT@example.com
SMTP_CONNECTION_URI=smtps://REPLACE_SENDER@gmail.com@smtp.gmail.com:465
TTL_EXPIRE_TYPE=day
TTL_EXPIRE_VALUE=7
