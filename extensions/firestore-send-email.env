# firebase/firestore-send-email configuration
# SMTP_CONNECTION_URI and SMTP_PASSWORD are secrets: set them with
#   firebase ext:configure firestore-send-email
# or put SMTP_PASSWORD in extensions/firestore-send-email.secret.local (git-ignored) for emulators.
LOCATION=asia-northeast1
MAIL_COLLECTION=mail
DEFAULT_FROM=Exam Practice <REPLACE_SENDER@gmail.com>
DEFAULT_REPLY_TO=hienct@fpt.com
SMTP_CONNECTION_URI=smtps://REPLACE_SENDER@gmail.com@smtp.gmail.com:465
TTL_EXPIRE_TYPE=day
TTL_EXPIRE_VALUE=7
